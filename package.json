{
  "name": "@mfe-kit/core",
  "version": "0.4.5",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfe-kit/core.git"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "test": "tsx ./src/tests.ts",
    "lint": "eslint src",
    "check": "prettier --ignore-path .gitignore --check src",
    "check:fix": "prettier --ignore-path .gitignore --write src && eslint --fix src"
  },
  "devDependencies": {
    "@mfe-kit/dev-tools": "github:mfe-kit/dev-tools#v0.5.15",
    "@types/node": "^24.3.0",
    "@types/jsdom": "^27.0.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.31.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "peerDependencies": {
    "vite": "^7.1.4",
    "jsdom": "^26.1.0 || ^27.0.0",
    "@hono/node-server": "^1.14.3 || ^2.0.0"
  }
}
