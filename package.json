{
  "name": "@mfe-kit/utils",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "eslint src",
    "check": "prettier --ignore-path .gitignore --check src",
    "check:fix": "prettier --ignore-path .gitignore --write src && eslint --fix src"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "vite": "^6.3.5",
    "esbuild": "^0.25.8",
    "husky": "^9.1.7"
  }
}
